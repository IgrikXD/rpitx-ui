{
  "format": {
    "line_width": 120,
    "tab_size": 4,
    "command_case": "lower",
    "keyword_case": "upper"
  },
  "lint": {
    "global_var_pattern": "[A-Z][0-9A-Z_]+",
    "internal_var_pattern": "_[A-Z][0-9A-Z_]+",
    "local_var_pattern": "[A-Z][0-9A-Z_]+",
    "argument_var_pattern": "[A-Z][0-9A-Z_]+",
    "keyword_pattern": "[A-Z][0-9A-Z_]+"
  }
}
